# Copy to `web/.env` (git-ignored) to point the web app at a project other than
# the local stack. You do not need this for local development: `lib/supabase.ts`
# falls back to the local stack's own values in a dev build. A production build
# has no fallback and needs both of these set in its deploy environment.
#
# Both values are safe in a bundle: the publishable key identifies the project
# and is not a credential. `npx supabase status` prints them for the local stack.
#
# The secret key must never appear in this file. Nothing in web/ needs it, and
# our tables are closed to every Data API role anyway — see the
# close_the_data_api migration.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the API is. Unset in dev, so calls go through Vite's /api proxy.
# VITE_API_BASE=
