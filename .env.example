# AIRA environment
#
#   cp .env.example .env     then fill in the blanks below
#
# This file is the template and is committed. `.env` is your copy, is
# gitignored, and is the only one that should ever hold a real key.
#
# It lives at the repo root, not in api/. Both `api/app/config.py` (via
# pydantic-settings) and the task runner read it from here. Loading also pushes
# these into the process environment, because an integration's
# `secret_ref = "env:NAME"` resolves against os.environ — in a hosted deploy
# that is where a secret manager will have put it.
#
# Check your work with:  python tasks.py env


# ===========================================================================
# Canonical database — needed now
# ===========================================================================

# Local development: the Supabase CLI stack started by `python tasks.py db`.
# This is the CLI's default and needs no changes.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Hosted deploy target: the Supabase project AIRetailAssistant
# (ref tshakhmvyxqnoytlfklw, us-west-2). Copy the connection string from
# Dashboard > Project Settings > Database and change the scheme to
# `postgresql+asyncpg://`. Behind the transaction-mode pooler, asyncpg also
# needs `?prepared_statement_cache_size=0` — the pooler does not keep prepared
# statements across checkouts.
# DATABASE_URL=postgresql+asyncpg://postgres.tshakhmvyxqnoytlfklw:<password>@<pooler-host>:5432/postgres


# ===========================================================================
# Anthropic — needed from phase 8 (the agent)
# ===========================================================================

# Get one at https://console.anthropic.com/settings/keys — it starts with
# "sk-ant-". Paste the value only: no quotes, no trailing spaces.
ANTHROPIC_API_KEY=

# Leave these alone unless you have a reason. The agent model does the
# analysis; the utility model does conversation titles and eval grading.
AGENT_MODEL=claude-sonnet-5
UTILITY_MODEL=claude-haiku-4-5-20251001


# ===========================================================================
# Embeddings — needed from phase 7 (retrieval)
# ===========================================================================

# Get one at https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=

# 1024 dimensions is a hard requirement, not a preference: pgvector's HNSW
# index cannot index a plain vector column above 2,000 dimensions, and the
# chunks table is already migrated at vector(1024).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# Offline alternative, no key required. Set EMBEDDING_PROVIDER=local to use a
# 1024-dim local model instead of Voyage. Vectors from different models are not
# comparable, so switching means re-embedding everything.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5


# ===========================================================================
# API server — defaults are fine
# ===========================================================================

API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated. The Vue dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173


# ===========================================================================
# Fake customer source systems — development only
# ===========================================================================
# Not secrets. These are the fixed tokens the local RegisterOne mock hands out,
# and they are in the committed template on purpose so the fixture works out of
# the box. A real customer's credential belongs in a secret manager, and only
# its `env:NAME` pointer belongs in an integration row.

# The RegisterOne integration's secret_ref is `env:REGISTERONE_TOKEN`, so this
# is what the adapter authenticates with.
REGISTERONE_TOKEN=ro_test_tsundoku_2f8a41
# Admin-only: /_simulate/day and /_simulate/fault-rate.
REGISTERONE_ADMIN_TOKEN=ro_admin_9c3e77
REGISTERONE_BASE_URL=http://localhost:8100

# Ground truth for the adapter's tests, which are allowed to read the fake POS's
# database directly. The adapter itself never may.
REGISTERONE_DB_DSN=postgresql+asyncpg://registerone:registerone@127.0.0.1:5433/registerone

# The mock API's own behaviour (rate limit, fault injection, page size) is set
# on its container in docker-compose.yml, not here.
