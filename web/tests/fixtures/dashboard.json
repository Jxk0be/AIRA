    {
      "key": "net_sales",
      "label": "Net sales",
      "definition": "The headline sales figure, and the one a POS prints: what was sold, less discounts, less refunds. Tax and tips are excluded because neither is the shop's money. Sales are counted on the day they were rung up, in the shop's own timezone. Canceled orders are left out entirely; open and completed orders both count.",
      "formula": "gross sales - discounts - refunds",
      "unit": "money",
      "value": "5849.60",
      "previous": "7827.30",
      "change": "-0.2527"
    },
    {
      "key": "order_count",
      "label": "Orders",
      "definition": "How many separate transactions there were, however many items each one had.",
      "formula": "count of distinct orders",
      "unit": "count",
      "value": "121",
      "previous": "154",
      "change": "-0.2143"
    },
    {
      "key": "average_order_value",
      "label": "Average order value",
      "definition": "What a typical transaction was worth, after discounts but before refunds are netted off.",
      "formula": "(gross sales - discounts) / orders",
      "unit": "money",
      "value": "49.46",
      "previous": "51.76",
      "change": "-0.0444"
    },
    {
      "key": "inventory_value",
      "label": "Inventory value",
      "definition": "What is sitting on the shelves right now, valued two ways: at what it would sell for, and at what it cost to buy. Stock levels are as of the last sync, not live.",
      "formula": "sum of on-hand x price, and sum of on-hand x cost",
      "unit": "money",
