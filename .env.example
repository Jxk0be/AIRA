DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase Auth ---
#
# The project's API URL. Tokens are verified against the JWKS it serves, so this
# has to match the project the browser signs in to. `/health` reports whether it
# is reachable, and the API answers 503 rather than letting requests through when
# it is unset.
#
#   local   http://127.0.0.1:54321          (`npx supabase status` → API_URL)
#   hosted  https://<project-ref>.supabase.co
#
# For AIRetailAssistant that is https://tshakhmvyxqnoytlfklw.supabase.co. It is
# NOT the same value in both places — a deploy that keeps the loopback address
# authenticates nobody.
SUPABASE_URL=http://127.0.0.1:54321

# Leave this blank. It exists only for a project whose auth is served from a
# custom domain, so that tokens name an issuer other than the default
# {SUPABASE_URL}/auth/v1. There is nothing to look up in the dashboard.
SUPABASE_JWT_ISSUER=

# Admin key. Needed only by `python tasks.py invite --send`, which asks the auth
# server to email an invitation; nothing else uses it and no request needs it, so
# leaving it blank is fine.
#
#   local   `npx supabase status` → SECRET_KEY
#   hosted  dashboard → Project Settings → API Keys → secret key (sb_secret_...)
#
# This one IS a secret. It bypasses row-level security. Never put it in `web/`,
# never send it to a browser, and never commit it.
SUPABASE_SERVICE_KEY=

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
UTILITY_MODEL=claude-haiku-4-5-20251001

VOYAGE_API_KEY=

EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024
EMBEDDING_MAX_RPM=0

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

APP_BASE_URL=http://localhost:5173
NOTIFY_TRANSPORT=console
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_NAME=AIRA
DIGEST_STALE_HOURS=48

REGISTERONE_TOKEN=ro_test_animanga_knox_2f8a41
REGISTERONE_ADMIN_TOKEN=ro_admin_9c3e77
REGISTERONE_BASE_URL=http://localhost:8100
REGISTERONE_DB_DSN=postgresql+asyncpg://registerone:registerone@127.0.0.1:5433/registerone